{
    "name": "@yakit-libs/color",
    "version": "1.4.1",
    "description": "A set of color designs derived from Yakit",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "require": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./preview": {
            "types": "./dist/preview.d.ts",
            "require": "./dist/preview.js",
            "default": "./dist/preview.js"
        },
        "./generator": {
            "types": "./dist/generator.d.ts",
            "require": "./dist/generator.js",
            "default": "./dist/generator.js"
        },
        "./component": {
            "types": "./dist/component.d.ts",
            "require": "./dist/component.js",
            "default": "./dist/component.js"
        },
        "./css": {
            "types": "./dist/css-generator.d.ts",
            "require": "./dist/css-generator.js",
            "default": "./dist/css-generator.js"
        },
        "./node": {
            "types": "./dist/node.d.ts",
            "require": "./dist/node.js",
            "default": "./dist/node.js"
        }
    },
    "bin": {
        "yakit-color-css": "./dist/cli.js"
    },
    "scripts": {
        "generate": "tsx scripts/generate-precomputed.ts",
        "example:source-api": "tsx examples/source-api-example.ts",
        "build": "npm run generate && tsc",
        "test": "tsc -p test/tsconfig.json && tsx --test test/*.test.ts",
        "watch-build": "tsc --watch",
        "prepublishOnly": "npm run build"
    },
    "keywords": [
        "@yakit-libs/color",
        "@yakit-libs"
    ],
    "author": "",
    "license": "MIT",
    "packageManager": "pnpm@10.12.4",
    "devDependencies": {
        "@types/node": "^22.17.0",
        "tsx": "^4.20.3",
        "typescript": "^5.9.2"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/yaklang/YakitLibs",
        "directory": "packages/color"
    },
    "bugs": {
        "url": "https://github.com/yaklang/YakitLibs/issues"
    },
    "homepage": "https://github.com/yaklang/YakitLibs/packages/color/README.md"
}
